# Environment Variables Template
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or any file with real secrets to Git.

# ─── DATABASE ────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# ─── AUTHENTICATION ───────────────────────────────────────────────
# NextAuth.js secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── META / INSTAGRAM ─────────────────────────────────────────────
# Meta app credentials (from developers.facebook.com)
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="replace-with-random-string"

# ─── NEWS API PROVIDERS ───────────────────────────────────────────
# GNews API (from gnews.io)
GNEWS_API_KEY="your-gnews-api-key"

# The Guardian Open API (from open-platform.theguardian.com)
GUARDIAN_API_KEY="your-guardian-api-key"

# NewsData.io (from newsdata.io — Phase 2)
# NEWSDATA_API_KEY="your-newsdata-api-key"

# ─── REDIS ────────────────────────────────────────────────────────
# Upstash Redis REST URL and token
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── OBJECT STORAGE ───────────────────────────────────────────────
# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="parmanu-media"

# ─── ENCRYPTION ───────────────────────────────────────────────────
# AES-256-GCM key for encrypting OAuth tokens at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-encoded-key"

# ─── MONITORING ───────────────────────────────────────────────────
SENTRY_DSN="your-sentry-dsn"
SENTRY_ENVIRONMENT="development"

# ─── APP CONFIGURATION ────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
